import math, os

h = []  # histórico

while True:
    os.system('cls' if os.name=='nt' else 'clear')
    print("🧮 CALCULADORA PYTHON")
    print("1+ 2- 3* 4/ 5^ 6√ 7H 0S")
    
    op = input("→ ")
    if op == '0': print("👋"); break
    if op == '7': print("Hist:", h[-5:]); input()
    
    try:
        a = float(input("N1: "))
        b = float(input("N2: ")) if op != '6' else 0
        
        r = (a+b,op+'+')[op=='1'] or (a-b,op+'-')[op=='2'] or \
            (a*b,op+'*')[op=='3'] or (a/b if b else 'ZERO!',op+'/')[op=='4'] or \
            (a**b,op+'^')[op=='5'] or (math.sqrt(a),op+'√')[op=='6']
            
        h.append(f"{a} {op} {b} = {r}")
        print(f"✅ {r}")
    except: print("❌ Erro!")
    input("⏸️ ")
